# Copy to ".env" and fill in. The app works WITHOUT these (local-first); they
# only enable optional cloud sync + Pro purchase. Only VITE_-prefixed vars are
# exposed to the client — never put a secret key here.

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay public Key ID (Dashboard → Settings → API Keys). The KEY SECRET is
# NOT set here — it lives only in the Supabase Edge Function secrets.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
