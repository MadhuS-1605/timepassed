<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compare_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/compare_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIME UNTIL"
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/compare_days_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="342"
        android:textColor="#22c55e"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_marginTop="0dp"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/compare_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAYS"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/compare_hours_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12h"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/compare_minutes_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30m"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/compare_target_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01/01/2026"
        android:textColor="#666666"
        android:textSize="10sp"
        android:layout_marginTop="12dp"/>

</LinearLayout>
