<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/habit_item_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/custom_progress_bar" 
        android:gravity="center"
        android:text=""
        android:layout_marginEnd="12dp"/>
    
    <!-- Using a simple view for checkbox circle simulation. In code we can swap drawable to checkmark -->

    <TextView
        android:id="@+id/habit_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Read Book"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <!-- Fire Icon -->
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_fire" 
            android:tint="#fb923c"
            android:visibility="visible"/>
            <!-- Using generic icon as placeholder for flame, tinting it orange -->

        <TextView
            android:id="@+id/habit_item_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="#fb923c"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
